# Create a GA4 web data stream and replace this with its Measurement ID.
# Example format: G-ABC1234567
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site URL — used for share links and OG metadata.
# Set this in Netlify > Site Settings > Environment variables when deploying.
NEXT_PUBLIC_SITE_URL=https://kamgartimes.com

NEXT_PUBLIC_API_URL=https://your-backend-url/api/v1
